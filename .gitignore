# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Model weights & artefak besar.
# `best.pt` sengaja ikut repositori supaya hasil clone langsung menjalankan
# mode YOLOv11-seg; checkpoint percobaan lain tetap lokal.
models/*.pt
!models/best.pt
models/*.pth
models/*.onnx
models/*.tflite
models/*.pkl
# Artefak classifier final ikut repo supaya deploy memakai model yang sama.
!models/best_rf.pkl
!models/best_mlp_sklearn.pkl
!models/label_encoder.pkl
!models/feature_scaler.pkl
!models/pakcoy_mlp.tflite
models/*.joblib
models/*.h5
models/*.keras
dataset/*.pt

